{
  "name": "hipstaff-pm-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/client",
    "build": "npm run build --workspace=apps/client && npm run build --workspace=apps/server",
    "start": "npm run start --workspace=apps/client",
    "lint": "npm run lint --workspace=apps/client && npm run lint --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:server": "npm run dev --workspace=apps/server",
    "build:client": "npm run build --workspace=apps/client",
    "build:server": "npm run build --workspace=apps/server"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
